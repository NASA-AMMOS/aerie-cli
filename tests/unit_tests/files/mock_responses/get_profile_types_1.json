[
    {
        "request": {
            "query": "query GetProfileTypes($simulation_dataset_id: Int!) { simulation_dataset_by_pk(id: $simulation_dataset_id) { dataset { profiles { name type } } } }",
            "variables": {
                "simulation_dataset_id": 1
            }
        },
        "response": {
            "dataset": {
                "profiles": [
                    {
                        "name": "dataVolume",
                        "type": {
                            "type": "real",
                            "schema": {
                                "type": "struct",
                                "items": {
                                    "rate": {
                                        "type": "real"
                                    },
                                    "initial": {
                                        "type": "real"
                                    }
                                }
                            }
                        }
                    },
                    {
                        "name": "totalRate",
                        "type": {
                            "type": "discrete",
                            "schema": {
                                "type": "real"
                            }
                        }
                    },
                    {
                        "name": "hardwareState",
                        "type": {
                            "type": "discrete",
                            "schema": {
                                "type": "variant",
                                "variants": [
                                    {
                                        "key": "OFF",
                                        "label": "OFF"
                                    },
                                    {
                                        "key": "ON",
                                        "label": "ON"
                                    }
                                ]
                            }
                        }
                    }
                ]
            }
        }
    }
]